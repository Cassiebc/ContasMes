# Copie este arquivo para .env e preencha com os valores do seu projeto.
# Supabase: Project Settings -> API Keys.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Use a chave PUBLICA (publishable / anon), nunca a secreta (secret /
# service_role). Ela vai embutida no bundle que qualquer um baixa —
# quem protege os dados e o RLS no banco, nao o segredo da chave.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Conta usada pelos testes de ponta a ponta (npm run e2e).
# NAO use a sua conta real: os testes apagam e recriam os meses do usuario.
# Veja e2e/README.md.
E2E_EMAIL=
E2E_SENHA=
